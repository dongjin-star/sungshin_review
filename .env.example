# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
#
# 카카오 REST API 키 (JavaScript 키가 아니라 REST 키입니다)
#   https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
#
# 이 키는 server/proxy.mjs 안에서만 읽히고 브라우저로는 나가지 않습니다.
# .env 는 .gitignore 에 있습니다. 저장소가 public 이므로 절대 커밋하지 마세요.
KAKAO_REST_KEY=

# 개발 서버 포트 (선택, 기본 5173)
PORT=5173
